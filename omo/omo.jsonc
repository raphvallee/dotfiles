// OMO configuration
{
  "[opencode]": {
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
    "telemetry": false,
    "auto_update": true,
    "disabled_agents": [
      "sisyphus",
      "hephaestus",
      "prometheus",
      "oracle",
      "librarian",
      "multimodal-looker",
      "metis",
      "momus",
      "atlas",
      "sisyphus-junior"
    ],
    "claude_code": {
      "mcp": false,
      "commands": false,
      "skills": false,
      "agents": false,
      "hooks": false,
      "plugins": false
    },
    "goal": {
      "enabled": true,
      "auto_start": false,
      "default_max_iterations": 8
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}