{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "opencode-goal-plugin",
      {
        "budgetWrapupRatio": 0.8,
        "commandName": "goal",
        "goalAgentName": "goal",
        "lifecycleMessages": true,
        "maxDurationMs": 900000,
        "maxPromptFailures": 3,
        "maxRecentMessages": 50,
        "maxStoredResults": 200,
        "maxTokens": 200000,
        "maxTurns": 10,
        "minDelayMs": 1500,
        "noContinueWhileChildrenActive": true,
        "noInterruptOnUserMessage": true,
        "noProgressTokenThreshold": 50,
        "noProgressTurnsBeforePause": 2,
        "noToolCallTurnsBeforePause": 2,
        "persistState": true,
        "registerAgents": true,
        "registerCommand": true,
        "registerTools": true,
        "resultRetentionMs": 604800000,
        "stateFilePath": ".opencode/goals/state.json",
        "verifierAgentName": "goal-verify",
        "warnDurationMsRemaining": 60000,
        "warnTokensRemaining": 25000,
        "warnTurnsRemaining": 3
      }
    ]
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "lsp": true,
  "formatter": true,
  "model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "small_model": "lmstudio/qwen3.5-4b",
  "enabled_providers": [
    "lmstudio",
    // "openrouter"
  ],
  "autoupdate": true,
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://192.168.1.145:25568/v1"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "tool_call": true,
          "reasoning": true,
          "options": {
            "enableThinking": true,
            "preserveThinking": false
          },
          "limit": {
            "context": 131072,
            "output": 65536
          },
        },
        "nvidia-nemotron-3.5-lightning-30b-a3b": {
          "name": "Nvidia Nemotron 3.5 Lightning 30B A3b",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "ling-3.0-tiny": {
          "name": "Ling 3.0 Tiny",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "qwen3.5-4b": {
