		"llamacpp-g9v3": {
			"name": "llamacpp-g9v3",
			"settings": {
				"baseURL": "http://127.0.0.1:8080/v1",
				"timeout": 1800000, //30m default = 300000 (5m)
				"headerTimeout": 1800000, //30m default = 300000 (5m)
				"chunkTimeout": 1800000 //30m default = 300000 (5m)
			},
			"models": {
				"G9v3-39A5B-Q4_K_M": {
					"name": "G9v3 39A5B",
					"capabilities": {
						"tools": true
					},
					"limit": {
						"context": 128000,
						"output": 65536
					},
					"variants": [
						{
							"id": "low",
							"settings": {
								"reasoningEffort": "low"
							}
						},
						{
							"id": "medium",
							"settings": {
								"reasoningEffort": "medium"
							}
						},
