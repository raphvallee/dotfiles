			"models": {
				"z-ai/glm-5.3-flash": {
					"name": "GLM 5.3 Flash",
					"capabilities": {
						"tools": true
					},
					"limit": {
						"context": 400000,
						"output": 131072
					},
					"cost": {
						"input": 0.15,
						"output": 0.5
					}
				}
			}
		}
	},
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp"
			},
			"playwright": {
				"type": "local",
				"command": [
					"bunx",
					"-y",
					"@playwright/mcp@latest"
				],
				"disabled": false
			}
		}
	},
	"permissions": [
		{
			"action": "read",
			"resource": ".env",
			"effect": "allow"
		},
		{
			"action": "read",
			"resource": ".env.*",
			"effect": "allow"
		},
		{
			"action": "read",
			"resource": ".env-*",
			"effect": "allow"
		},
		{
			"action": "external_directory",
			"resource": "*",
			"effect": "deny"
		},
		{
			"action": "shell",
			"resource": "git push",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git push *",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "sudo *",
			"effect": "deny"
		},
		{
			"action": "shell",
			"resource": "rm -rf /",
			"effect": "deny"
		},
		{
			"action": "shell",
			"resource": "rm -rf /*",
			"effect": "deny"
		},
		{
			"action": "shell",
			"resource": "rm -rf ~",
			"effect": "deny"
		},
		{
			"action": "shell",
			"resource": "rm -rf ~/*",
			"effect": "deny"
		},
		{
			"action": "shell",
			"resource": ":(){:|:&};:",
			"effect": "deny"
		}
	]
}