		"openrouter": {
			"name": "OpenRouter",
			"whitelist": [
				"openai/gpt-5.6-luna",
				"z-ai/glm-5.3-flash",
				"openai/gpt-5.6-sol"
			],
			"models": {
				"openai/gpt-5.6-luna": {
					"name": "1- GPT-5.6 Luna",
					"tool_call": true,
					"reasoning": true,
					"limit": {
						"context": 400000,
						"output": 128000
					},
					"cost": {
						"input": 0.20,
						"output": 1.20
					},
					"variants": {
						"low (1.1)": {
							"reasoningEffort": "low",
						},
						"medium (1.2)": {
							"reasoningEffort": "medium",
						},
						"high (1.3)": {
							"reasoningEffort": "high",
						},
						"xhigh (1.4)": {
							"reasoningEffort": "xhigh",
						},
						"max (1.5)": {
							"reasoningEffort": "max",
						},
					},
				},
				"z-ai/glm-5.3-flash": {
					"name": "2- GLM-5.3-Flash",
					"tool_call": true,
					"reasoning": true,
					"limit": {
						"context": 400000,
						"output": 131072
					},
					"cost": {
						"input": 0.15,
						"output": 0.5
					}
				},
				"openai/gpt-5.6-sol": {
					"name": "3- GPT-5.6 Sol (xhigh)",
					"tool_call": true,
					"reasoning": true,
					"limit": {
						"context": 400000,
						"output": 128000
					},
					"cost": {
						"input": 4,
						"output": 20
					},
					"variants": {
						"xhigh (7)": {
							"reasoningEffort": "xhigh",
						}
					},
				}
			}
		},
		"llamacpp-g9v3": {
			"name": "llamacpp-g9v3",
			"options": {
				"baseURL": "http://127.0.0.1:8080/v1"
			},
			"models": {
				"G9v3-39A5B-Q4_K_M": {
					"name": "G9v3 39A5B",
					"tool_call": true,
					"reasoning": true,
					"limit": {
						"context": 128000,
						"output": 65536
					},
					"variants": {
						"low": {
							"reasoningEffort": "low",
						},
						"medium": {
							"reasoningEffort": "medium",
						},
						"high": {
							"reasoningEffort": "high",
						},
						"max": {
							"reasoningEffort": "max",
						},
					},
				}
			}
		}
	},
	"permission": {
		"read": {
			".env": "allow",
			".env.*": "allow",
			".env-*": "allow"
		},
		"external_directory": "allow",
		"bash": {
			"git push": "allow",
			"git push *": "allow",
			"sudo *": "deny",
			"rm -rf /": "deny",
			"rm -rf /*": "deny",
			"rm -rf ~": "deny",
			"rm -rf ~/*": "deny",
			":(){:|:&};:": "deny"
		}
	}
}