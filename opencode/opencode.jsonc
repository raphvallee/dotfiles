{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "small_model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "enabled_providers": [
    "lmstudio",
    // "openrouter"
  ],
  "autoupdate": true,
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://173.178.243.192:25568/v1"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "tool_call": true,
          "reasoning": true,
          "options": {
            "enableThinking": true,
            "preserveThinking": false
          },
          "limit": {
            "context": 131072,
            "output": 65536
          },
        },
        "qwen/qwen3-30b-a3b-2507": {
          "name": "Qwen3 30B A3B 2507",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 131072,
            "output": 32768
          },
        },
        "qwen/qwen3.5-4b": {
          "name": "Qwen3 30B A3B 2507",
          "tool_call": true,
          "reasoning": false,
        },
        "qwen/qwen3-4b-thinking-2507": {
          "name": "Qwen3 4B Thinking 2507",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 32768
          },
        }
      }
    }
  },
  "permission": {
    // .env reads without prompts
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow"
    },
    "external_directory": "allow",
    "bash": {
      "git push": "allow",
      "git push *": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny"
    }
  },
}