						"top_k": 20,
						"min_p": 0,
						"presence_penalty": 1.5
					},
					"limit": {
						"context": 131072,
						"output": 65536
					},
					"variants": [
						{
							"id": "coding",
							"settings": {
								"reasoningEffort": "max",
								"temperature": 0.6,
								"top_p": 0.95,
								"top_k": 20,
								"min_p": 0,
								"presence_penalty": 1.5,
								"thinking": {
									"type": "enabled",
